# 说明：本文件是模板，会被提交；真实密钥与账号只写进 .env
# ---- 应用 ----
WAHU_ENV=dev
WAHU_LOG_LEVEL=INFO
WAHU_TENANT_ID=default

# ---- 存储 ----
# sqlite = 本机零依赖（默认，适合开发与联调）；postgres = 生产
WAHU_STORAGE=sqlite
WAHU_SQLITE_PATH=data/wahu.sqlite3
WAHU_DATABASE_URL=postgresql+psycopg://wahu:wahu@localhost:5434/wahu
# 启动时按元数据建表（CREATE TABLE IF NOT EXISTS，可重复执行）
WAHU_AUTO_MIGRATE=true

# ---- 安全 ----
# 生产必须改：人工登录令牌都依赖它
WAHU_SECRET_KEY=dev-only-change-me
WAHU_TOKEN_TTL_HOURS=12
WAHU_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WAHU_BOOTSTRAP_ADMIN_PASSWORD=admin12345
WAHU_BOOTSTRAP_ADMIN_NAME=系统管理员

# ---- 线路（外呼）----
# simulated = 模拟线路（默认，离线可跑，不产生真实话费）
# rest    = 真实线路：把呼叫交给线路网关，状态由网关回调驱动（详见 docs/telephony.md）
WAHU_TELEPHONY_PROVIDER=simulated
# 模拟接通率（0~1）与响铃 / 无人接听时长，决定演示与测试里通话状态机的走向
WAHU_TELEPHONY_ANSWER_RATE=0.6
WAHU_TELEPHONY_RING_SECONDS=4
WAHU_TELEPHONY_NO_ANSWER_SECONDS=20
# 状态机推进的节拍（毫秒），越小状态切换越顺滑
WAHU_TELEPHONY_TICK_MS=300
# ---- 真实线路（只有 WAHU_TELEPHONY_PROVIDER=rest 时才读下面这些）----
# 线路网关地址；网关要实现 POST /calls、POST /calls/{id}/hangup 两个接口
WAHU_TELEPHONY_BASE_URL=
# 线路令牌：出站请求带 Authorization: Bearer，回调要带 X-Wahu-Token（或 ?token=）
WAHU_TELEPHONY_TOKEN=
# 双呼模式：先呼这个坐席号码，坐席接起后再呼客户。真实外呼线路基本都是这个模式
WAHU_TELEPHONY_AGENT_PHONE=
# 拨号后多久没收到任何线路回调就判失败（秒），避免永远挂在「拨号中」
WAHU_TELEPHONY_TIMEOUT_SECONDS=20
# 线路厂商的状态码/状态名 → 本系统状态，例如 {"2":"answered","3":"hangup"}
# 支持：ringing / answered / hangup / failed / no_answer / busy / power_off / invalid_number / canceled
WAHU_TELEPHONY_STATE_MAP={}

# ---- 录音 ----
WAHU_RECORDING_ENABLED=true
WAHU_RECORDING_DIR=var/recordings

# ---- 合规 ----
# 免打扰时段；跨零点时写成 start > end（默认 21:00 到次日 09:00 禁呼）
WAHU_COMPLIANCE_DND_START=21:00
WAHU_COMPLIANCE_DND_END=09:00
# 每坐席每日拨打上限
WAHU_COMPLIANCE_DAILY_LIMIT=200
# 同一号码每日最多拨打次数
WAHU_COMPLIANCE_PER_NUMBER_DAILY_LIMIT=3
# 号码默认脱敏；管理员看全号会记审计
WAHU_COMPLIANCE_MASK_PHONE=true

# ---- 自研 CRM（对接 D:\crm）----
# fake = 内置假数据（离线可跑）；rest = 调自研 CRM REST
WAHU_CRM_MODE=fake
WAHU_CRM_BASE_URL=http://127.0.0.1:9100/api/v1
# 必须与 D:\crm 的 CRM_SERVICE_TOKEN 一致
WAHU_CRM_API_TOKEN=dev-service-token
# 回写时用 X-Actor-Id 声明操作者，便于 CRM 归因
WAHU_CRM_ACTOR_ID=wahu-system
WAHU_CRM_PAGE_SIZE=100
WAHU_CRM_RATE_LIMIT_PER_SEC=5
WAHU_CRM_MAX_RETRIES=4
WAHU_CRM_TIMEOUT_SECONDS=15

# ---- 大模型（二期 AI 机器人）----
# stub = 离线占位；live = 真实 OpenAI 兼容接口（默认 DeepSeek）
WAHU_LLM_MODE=stub
WAHU_LLM_BASE_URL=https://api.deepseek.com/v1
WAHU_LLM_API_KEY=replace-me
WAHU_LLM_MODEL=deepseek-chat
WAHU_LLM_TIMEOUT_SECONDS=60
# simulated = 模拟语音（文本轮次 + 事件流）；真实 ASR/TTS 适配器二期预留
WAHU_VOICE_PROVIDER=simulated

# ---- 机器人 ----
WAHU_ROBOT_CONCURRENCY=3

# ---- 前端 ----
# true 且 web/dist 存在时，由 FastAPI 直接托管前端构建产物
WAHU_SERVE_WEB=true
WAHU_WEB_DIST_DIR=web/dist
WAHU_CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176

# ---- 分页与限制 ----
WAHU_DEFAULT_PAGE_SIZE=50
WAHU_MAX_PAGE_SIZE=200

# ---- 生产环境（WAHU_ENV=prod / production / stage / staging）----
# 落到生产取值后，下面任何一项没做到都会直接启动失败：默认密钥、默认管理员口令、
# 模拟线路、模拟语音、stub 大模型、脱敏关闭、CORS 通配。
# 只有下面这一项保留了显式开关（明确要在生产用模拟能力时才打开）：
#   WAHU_ALLOW_SIMULATED_IN_PROD=true